# 移动云盘：Authorization值#手机号[#YYYY-MM-DD]
# ydyp=Authorization#手机号
# 联通营业厅：手机号#APP登录专用密码#appId（appId 可省略，多账号用 & 连接）
# UNICOM_ACCOUNT=13800000000#app-password#1406a14ec25d9b783bc0fd29eacd072acfdae2811573d8d00d001205217142b4
# 或直接给 Cookie（最稳妥）
# UNICOM_COOKIE=
# 脚本成功后会把当天日期写回变量末尾，例如 #2026-10-06
# 联通云盘活动（可选，活动换期时改）
# UNICOM_CLOUD_LOTTERY_ACTIVITY_ID=MjU=
# UNICOM_CAMPUS_ACTIVITY_ID=MzU=
# UNICOM_BATTLE_ACTIVITY_ID=Mzg=
# UNICOM_BATTLE_UPLOAD_URL=https://hyupload.pan.wo.cn/openapi/client/upload2C
# 钉钉机器人（任务完成后推送结果）
# DD_BOT_TOKEN=access_token（自定义机器人未加签时只填这个）
# DD_BOT_SECRET=加签密钥（仅加签机器人需要）
